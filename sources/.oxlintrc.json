{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // React Compiler compatibility checks, new in oxlint 1.8x. This app does not run the
    // compiler; the flagged shapes (fetch-on-mount effects that set loading state, the
    // latest-value ref) are correct without it. Revisit if the compiler is adopted.
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/preserve-manual-memoization": "off",
    "react/immutability": "off"
  }
}
