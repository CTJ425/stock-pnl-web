# Ignore the read-only GAS template project (kept locally as reference)
template/

# Ignore web application dependencies and builds
node_modules/
dist/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore transaction CSV data and raw directory
raw/
*.csv


# Supabase CLI local artifacts (repo-root supabase/ is CLI-generated; real code is in sources/supabase/)
/supabase/.temp/
/supabase/.branches/
# Added by code-review-graph
.code-review-graph/

# Local agent skill installs / design dumps (not product code)
.agents/
.gemini/

# routing telemetry (local audit state, not source)
.claude/routing/

# Playwright generated report (regenerate with npm run test:e2e)
docs/e2e-report.html
sources/stock-search-e2e.png

# Python bytecode
__pycache__/
*.py[cod]

# Backups (scripts/db-backup.sh, scripts/db-migrate.sh, scripts/backup-download.cjs). They hold
# password hashes, the x-cron-secret inside cron.job commands and every user's transactions. This
# repo is PUBLIC and push protection does not recognise a password hash, so this rule is the only gate.
backups/
.snapshots/

# Throwaway agent / design files. 2026-10-07: 13 of them had been committed by mistake and were removed.
scratchpad/

# Impeccable engine binary: downloaded by the launcher, never committed
.claude/skills/impeccable/scripts/bin/
